# Құпия мәнді тек .env ішіне енгізіңіз. Git-ке қоспаңыз.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT=45
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Осы E5 моделі үшін тексерілген HF commit. Басқа модельде сәйкес revision таңдаңыз.
EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
# Алғашқы жүктеу: false; модель кэштелгеннен кейін true қоюға болады.
EMBEDDING_LOCAL_ONLY=false
CHUNK_TOKENS=450
CHUNK_OVERLAP=90
TOP_K=5
MIN_SIMILARITY=0.80
MAX_UPLOAD_MB=20
MAX_PAGES=300
MAX_CHUNKS=2000
MAX_DOCUMENTS=50
DATA_DIR=data
